# Bitvavo API Credentials
# Get your API credentials from https://account.bitvavo.com/user/api
BITVAVO_API_KEY=your_api_key_here
BITVAVO_API_SECRET=your_api_secret_here
BITVAVO_OPERATOR_ID=1

# Optional: Database path (defaults to ./data/trades.db if not set)
# TRADER_DB_PATH=/path/to/trades.db

# Virtual Trading Configuration (Paper Trading)
# Enable virtual trading mode to test strategies without real money
VIRTUAL_TRADING=false
VIRTUAL_DB_PATH=data/virtual_trades.db
VIRTUAL_INITIAL_BALANCE=1000.0  # Recommended: €1000 for meaningful testing
VIRTUAL_TRADING_FEE=0.25        # Bitvavo's typical fee is ~0.25%
